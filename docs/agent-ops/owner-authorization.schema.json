{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Distributed Discovery Agent Operations owner authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "synthetic",
    "gate_id",
    "issue",
    "pull_request",
    "branch",
    "commit",
    "task_contract_sha256",
    "tree_hashes",
    "authorized_at_utc",
    "expires_at_utc",
    "challenge",
    "owner_confirmation_statements",
    "authorization_digest"
  ],
  "properties": {
    "schema_version": {"const": "agent-ops-owner-authorization-v1"},
    "kind": {"const": "owner-authorization"},
    "synthetic": {"const": false},
    "gate_id": {"type": "string", "pattern": "^AOG-[A-Z0-9][A-Z0-9-]{2,48}$"},
    "issue": {"type": "integer", "minimum": 1},
    "pull_request": {"type": "integer", "minimum": 1},
    "branch": {"type": "string", "minLength": 1},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "task_contract_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "tree_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "authorized_at_utc": {"type": "string", "format": "date-time"},
    "expires_at_utc": {"type": "string", "format": "date-time"},
    "challenge": {"type": "string", "pattern": "^AUTHORIZE AOG-[A-Z0-9-]+ [0-9a-f]{7}$"},
    "owner_confirmation_statements": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "authorization_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
