{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Distributed Discovery Agent Operations owner gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "synthetic",
    "gate_id",
    "task_contract",
    "issue",
    "pull_request",
    "branch",
    "commit",
    "tree_hashes",
    "purpose",
    "irreversible_actions",
    "private_actions",
    "external_actions",
    "cumulative_state",
    "hard_caps",
    "remaining_caps",
    "owner_confirmation_statements",
    "explicit_prohibitions",
    "expires_at_utc",
    "authorization_output_symbolic_path",
    "next_milestone",
    "generated_resume_message"
  ],
  "properties": {
    "schema_version": {"const": "agent-ops-owner-gate-v1"},
    "kind": {"const": "owner-gate"},
    "synthetic": {"const": false},
    "gate_id": {"type": "string", "pattern": "^AOG-[A-Z0-9][A-Z0-9-]{2,50}$"},
    "task_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/|.*\\.\\.).+\\.(yml|yaml)$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "issue": {"type": "integer", "minimum": 1},
    "pull_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "expected_state", "head_sha"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "expected_state": {"const": "OPEN"},
        "head_sha": {"$ref": "#/$defs/commit"}
      }
    },
    "branch": {"type": "string", "minLength": 1},
    "commit": {"$ref": "#/$defs/commit"},
    "tree_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "purpose": {"type": "string", "minLength": 8},
    "irreversible_actions": {"$ref": "#/$defs/actions"},
    "private_actions": {"$ref": "#/$defs/actions"},
    "external_actions": {"$ref": "#/$defs/actions"},
    "cumulative_state": {"$ref": "#/$defs/capState"},
    "hard_caps": {"$ref": "#/$defs/capState"},
    "remaining_caps": {"$ref": "#/$defs/capState"},
    "owner_confirmation_statements": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 8}
    },
    "explicit_prohibitions": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "expires_at_utc": {"type": "string", "format": "date-time"},
    "authorization_output_symbolic_path": {
      "type": "string",
      "pattern": "^XDG_CONFIG_HOME/distributed-discovery/agent-ops/authorizations/AOG-[A-Z0-9-]+\\.yml$"
    },
    "next_milestone": {"type": "string", "minLength": 3},
    "generated_resume_message": {"type": "string", "minLength": 8, "maxLength": 2048}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["permission", "description"],
        "properties": {
          "permission": {
            "type": "string",
            "pattern": "^(permissions|external_action_permissions|scientific_mutation_permissions|private_data_permissions)\\.[a-z0-9_]+$"
          },
          "description": {"type": "string", "minLength": 3}
        }
      }
    },
    "capState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "spend", "calls", "category_spend"],
      "properties": {
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "spend": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$"},
        "calls": {"type": "integer", "minimum": 0},
        "category_spend": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)?$"
          }
        }
      }
    }
  }
}
