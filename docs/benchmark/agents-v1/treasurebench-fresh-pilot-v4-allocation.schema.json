    "slot_prefix": {"const": "RCV4-SLOT"},
    "boundary_cycle": {"const": ["strict", "equality-tie", "boundary", "protocol-sensitive", "parser-sensitive"]},
    "families": {"type": "object", "minProperties": 5, "maxProperties": 5, "additionalProperties": {"type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 30}}},
    "relabeling": {"const": {"target_rule": "alternate-within-family-offset-by-family", "agent_rule": "alternate-globally", "target_class_counts": {"target-A": 25, "target-B": 25}, "agent_class_counts": {"agent-A": 25, "agent-B": 25}}},
    "generation": {"const": {"private_variant_source": "new-os-csprng-seed-and-v4-slot-domain", "private_seed_created": false, "public_rehearsal_material": "FRESH-RC-V4-SYNTHETIC-PUBLIC-NONSECRET-V1", "original_pilot_instance_reuse": false, "repair_confirmation_v1_instance_reuse": false, "repair_confirmation_v2_instance_reuse": false, "repair_confirmation_v3_instance_reuse": false, "future_base_instance_reuse": false, "base_campaign_instance_reuse": false}}
  }
}
