{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TreasureBench Agents v1 fresh repair-confirmation v4 allocation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "campaign_id", "batch_id", "counts", "slot_prefix", "boundary_cycle", "families", "relabeling", "generation"],
  "properties": {
